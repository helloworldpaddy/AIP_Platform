# --- Gemini ------------------------------------------------------------------
# REQUIRED for the four agents.  Generate at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyDu_WQjL9dtTLvgGcWOiU-GcbMRWCq0Ey0
# Or, instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
EMBEDDING_MODEL=gemini-embedding-001
GENERATION_MODEL=gemini-2.5-flash
EMBEDDING_DIM=768

# --- Postgres (pgvector + AML schema, same DB) -------------------------------
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_PORT=5432
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
IVFFLAT_LISTS=100

# --- Cursor MCP (Postgres) ---------------------------------------------------
# Project file `.cursor/mcp.json` loads `${workspaceFolder}/.env` and connects
# to Postgres on 127.0.0.1 (host → published Docker port). Ensure the repo-root
# `.env` includes POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, POSTGRES_PORT
# (copy or symlink from `docker/.env` if you only edit that file).
# Server: `npx @modelcontextprotocol/server-postgres` (read-only SQL). If npm
# warns the package is deprecated, it may still be used until you switch MCP
# servers; edit `.cursor/mcp.json` to change the command/args.

# --- Neo4j -------------------------------------------------------------------
# Format MUST be `username/password` (Neo4j docker image convention).
NEO4J_AUTH=neo4j/neo4jpass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m

# --- Backend / Frontend ports ------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Comma-separated origins the FastAPI CORS middleware should accept.
# Include both the dev-server (5173) and the nginx-served frontend (8080).
AML_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO

# --- Agent transport (orchestrator ↔ stage execution) -------------------------
# Default: in_process (current ADK agents inside aml-backend).
# Per-stage override: AML_AGENT_TRANSPORT_DUE_DILIGENCE=a2a
# A2A agent card: AML_A2A_DUE_DILIGENCE_URL=http://dd-agent:8103/.well-known/agent-card.json
# AML_AGENT_TRANSPORT_DEFAULT=in_process
# AML_A2A_TIMEOUT_SECONDS=600

# --- Tool gateway (remote A2A agents call back for case-scoped tools) --------
# HMAC secret for run-scoped Bearer tokens (change in production).
# AML_TOOL_GATEWAY_SECRET=change-me-in-production
# Public base URL remote agents use to reach the gateway (no trailing slash).
# AML_TOOL_GATEWAY_BASE_URL=http://localhost:8000
# Token lifetime in seconds (default 3600).
# AML_TOOL_GATEWAY_TTL_SECONDS=3600

# --- ADK web runtime mode -----------------------------------------------------
# hybrid (default): ADK LLM in-process + callback persist (run_lifecycle)
# orchestrator: callbacks call Orchestrator.trigger_agent (respects A2A transport)
# AML_ADK_MODE=hybrid

# --- A2A resilience (Sprint 5) -----------------------------------------------
# AML_A2A_CIRCUIT_FAILURE_THRESHOLD=5
# AML_A2A_CIRCUIT_RECOVERY_SECONDS=60

# --- A2A stage hosts (docker compose --profile a2a) ---------------------------
# For the React frontend with all stages remote, use the ready-made overlay
# instead of uncommenting these manually:
#   docker compose -f docker/docker-compose.yml \
#     --env-file docker/.env --env-file docker/.env.a2a \
#     --profile a2a up --build
# See README.md § "Frontend with remote A2A agents" and docs/AGENT_TRANSPORT.md.
#
# Per-stage only (example — Due Diligence remote, others in-process):
# AML_AGENT_TRANSPORT_DUE_DILIGENCE=a2a
# AML_A2A_DUE_DILIGENCE_URL=http://dd-agent:8103/.well-known/agent-card.json
# AML_TOOL_GATEWAY_BASE_URL=http://backend:8000
#
# All-remote (same values as docker/.env.a2a):
# AML_AGENT_TRANSPORT_DEFAULT=a2a
# AML_A2A_INITIAL_ASSESSMENT_URL=http://ia-agent:8101/.well-known/agent-card.json
# AML_A2A_TRANSACTION_ENRICHMENT_URL=http://te-agent:8102/.well-known/agent-card.json
# AML_A2A_DUE_DILIGENCE_URL=http://dd-agent:8103/.well-known/agent-card.json
# AML_A2A_CASE_ANALYSIS_URL=http://ca-agent:8104/.well-known/agent-card.json
# AML_TOOL_GATEWAY_BASE_URL=http://backend:8000

# If an agent run stays RUNNING longer than this (API crash, stuck worker),
# it is reset to PENDING. Set high enough that normal LLM runs (e.g. Due
# Diligence) are not flagged; default 30 minutes.
AML_STALE_RUNNING_MINUTES=30

# --- Optional services -------------------------------------------------------
REDIS_PORT=6379
